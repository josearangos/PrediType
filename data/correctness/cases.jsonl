{"id": "casing-colon-line-break", "area": "casing", "input": "Estimado cliente:\n", "expect": {"all_capitalized": true}}
{"id": "casing-inside-quotes", "area": "casing", "input": "Le dijimos \"gracias", "expect": {"all_lowercase": true}}
{"id": "casing-mixed-lower-initial", "area": "casing", "input": "Hola, bUe", "expect": {"all_lowercase": true}}
{"id": "casing-mixed-upper-initial", "area": "casing", "input": "Hola, BUe", "expect": {"all_capitalized": true}}
