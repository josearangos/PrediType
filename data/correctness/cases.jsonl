{"id": "casing-after-three-dots", "area": "casing", "input": "Gracias por esperar... ", "expect": {"all_capitalized": true}}
{"id": "casing-mid-sentence-question", "area": "casing", "input": "Gracias, ¿c", "expect": {"all_lowercase": true}}
{"id": "casing-sentence-start-question", "area": "casing", "input": "Listo. ¿C", "expect": {"all_capitalized": true}}
